{% apply spaceless %}
    {% set showLogoutButton = properties.showLogoutButton ?: false %}
    <div class="justify-content-center logout-container" data-bsi-dropzone="logout-button-dropzone-4532Ads" data-bsi-remove-if="!authenticated" data-bsi-dropzone-max-number-of-elements="1">
            {% if showLogoutButton %}
                {% include '@bsi-cx/design-standard-library-web/content-elements/base/button/prototype/template.twig' with {
                    buttonText: 'Logout'
                }%}
            {% endif %}
    </div>
{% endapply %}
